<?xml version="1.0" encoding="utf-8"?>
<!-- Square widget (2 x 2): Golob on top, the level word and value, the tasks in one short line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/golob"
        android:layout_width="48dp"
        android:layout_height="58dp"
        android:contentDescription="Robert, golob"
        android:scaleType="fitCenter"
        android:src="@drawable/golob" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="5dp"
            android:src="@drawable/widget_dot" />

        <TextView
            android:id="@+id/level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nalagam…"
            android:textColor="#F5F5ED"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="–"
        android:textColor="#F5F5ED"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Še 4 naloge"
        android:textColor="#B9CDC4"
        android:textSize="11sp" />
</LinearLayout>
